# Unity 바이너리 파일 (Git LFS)
*.a filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.data filter=lfs diff=lfs merge=lfs -text
*.unitypackage filter=lfs diff=lfs merge=lfs -text

# Unity 에셋 파일 (Git LFS)
*.psd filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text

# 오디오 파일 (Git LFS)
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text

# 이미지 파일 (Git LFS)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text

# Frontend 이미지는 일반 Git으로 관리 (용량이 작음)
Frontend/**/*.png !filter !diff !merge !text
Frontend/**/*.jpg !filter !diff !merge !text

# Unity WebGL 빌드 - 큰 파일 (Git LFS)
Frontend/public/game/MMD4Mecanim_Data/*.assets filter=lfs diff=lfs merge=lfs -text
Frontend/public/game/MMD4Mecanim_Data/*.assets.resS filter=lfs diff=lfs merge=lfs -text
